    "title": "一次查询，三种失败责任",
    "caption": "原创非实测示意。先区分是否已成功收取请求，再决定能否补答；接收超时只使当前客户端失效。没有任何箭头表示自动重启服务端或一秒内完成生成。",
    "nodes": [
      {
        "id": "req",
        "label": "scheduler发起查询",
        "detail": "只画进入非layerwise外部lookup分支的请求；本地命中或无需外部查询可跳过。",
        "column": 0,
        "row": 0
      },
      {
        "id": "recv",
        "label": "服务端收取请求",
        "detail": "REP收取成功后才有对应回复义务；收取错误不能伪造已接收。",
        "column": 1,
        "row": 0
      },
      {
        "id": "handler",
        "label": "处理异常：回复零命中",
        "detail": "已收取，但解码或查询处理抛异常；零命中是正常回复格式。",
        "column": 2,
        "row": 0
      },
      {
        "id": "miss",
        "label": "放弃本次外部缓存信用",
        "detail": "scheduler收到零命中，按无新增外部token继续调度；不是外部存储已经恢复。",
        "column": 3,
        "row": 0
      },
      {
        "id": "recverr",
        "label": "收取或发送错误：退出",
        "detail": "退出服务线程，由处理线程finally关闭socket和context；没有补画服务线程自动重启。",
        "column": 2,
        "row": 1
      },
      {
        "id": "timeout",
        "label": "客户端接收超时/错误",
        "detail": "收不到有效回复时，已设置的接收等待上限触发ZMQ错误；并非发送和整体请求时限。",
        "column": 1,
        "row": 2
      },
      {
        "id": "close",
        "label": "关闭失效客户端",
        "detail": "socket与私有context幂等关闭，返回零命中。",
        "column": 2,
        "row": 2
      },
      {
        "id": "next",
        "label": "下次查询创建新客户端",
        "detail": "重新建立REQ状态；只有服务端仍可工作或已被外部恢复，才可能重新命中。",
        "column": 3,
        "row": 2
      }
    ],
    "edges": [
      {
        "from": "req",
        "to": "recv",
        "label": "请求控制消息"
      },
      {
        "from": "recv",
        "to": "handler",
        "label": "收取成功但处理失败"
      },
      {
        "from": "handler",
        "to": "miss",
        "label": "合法零命中回复"
      },
      {
        "from": "recv",
        "to": "recverr",
        "label": "I/O错误，停止服务循环"
      },
      {
        "from": "req",
        "to": "timeout",
        "label": "没有及时收到回复"
      },
      {
        "from": "timeout",
        "to": "close",
        "label": "作废本次REQ状态"
      },
      {
        "from": "close",
        "to": "next",
        "label": "下一次外部查询"
      }
    ],
    "presentation": {
