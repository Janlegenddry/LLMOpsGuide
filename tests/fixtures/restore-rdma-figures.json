  {
    "type": "diagram",
    "basis": "inference",
    "sourceIndices": [
      1,
      4
    ],
    "title": "预算账本：未共同结算的失败不能提前释放额度",
    "caption": "原创数字教学示例，非显存测量、非耗时或占比图。A的原始余量已包含真实分配的扣减；B未分配成功，故额外保留3000-token预留，使本例有效预算一致。实际分配器还有其他扣减项。右侧退休条件与预算扣减是独立关系，只有归约数组请求身份和顺序一致，才谈得上同一请求共同退休；图不把预算相同当作全系统同步证明。",
    "nodes": [
      {
        "id": "a-raw",
        "label": "A 原始预算：5,000",
        "detail": "本例中A已真实分配3000-token恢复空间；5000是分配后的可用预算。",
        "column": 0,
        "row": 0,
        "tone": "kv",
        "shortLabel": "A 余量 5000"
      },
      {
        "id": "a-adjust",
        "label": "A 额外预留扣减：0",
        "detail": "A已取得restore lock，不能再重复扣减同一笔恢复额度。",
        "column": 1,
        "row": 0,
        "tone": "control",
        "shortLabel": "不重复扣减"
      },
      {
        "id": "a-effective",
        "label": "A 有效预算：5,000",
        "detail": "本例用于该轮admission的预算，尚非所有rank或所有分配器的一般结论。",
        "column": 2,
        "row": 0,
        "tone": "kv",
        "shortLabel": "A 有效 5000"
      },
      {
        "id": "b-raw",
        "label": "B 原始预算：8,000",
        "detail": "本例中B恢复分配失败，原始预算比A多3000。",
        "column": 0,
        "row": 1,
        "tone": "kv",
        "shortLabel": "B 余量 8000"
      },
      {
        "id": "b-adjust",
        "label": "B 保留恢复预留：3,000",
        "detail": "FAILED但未取得restore lock、仍在transfer queue中，继续扣减该笔未结算额度。",
        "column": 1,
        "row": 1,
        "tone": "control",
        "shortLabel": "仍扣 3000"
      },
      {
        "id": "b-effective",
        "label": "B 有效预算：5,000",
        "detail": "本例8000减3000；防止B在共同退休前提前花掉恢复额度。",
        "column": 2,
        "row": 1,
        "tone": "kv",
        "shortLabel": "B 有效 5000"
      },
      {
        "id": "queued",
        "label": "仍排队且未获恢复锁",
        "detail": "独立生命周期条件：状态FAILED本身不让未获锁请求提前退出恢复预留计算。",
        "column": 0,
        "row": 3,
        "tone": "control",
        "shortLabel": "保留未结算账"
      },
      {
        "id": "retired",
        "label": "共同移出队列后结算",
        "detail": "共同移出以前提同序同身份为条件；移出后该请求不再出现在此队列的预留求和中。不是固定时限保证。",
        "column": 2,
        "row": 3,
        "tone": "control",
        "shortLabel": "共同退休再结算"
      },
      {
        "id": "budget-boundary",
        "label": "预算只是一个不变量",
        "detail": "状态一致、队列身份一致、页生命周期与有界恢复仍须分别验收。数字不代表GPU实测。",
        "column": 3,
        "row": 2,
        "tone": "neutral",
        "shortLabel": "独立安全边界"
      }
    ],
    "edges": [
      {
        "from": "a-raw",
        "to": "a-adjust",
        "label": "已分配计入原始余量"
      },
      {
        "from": "a-adjust",
        "to": "a-effective",
        "label": "5000 − 0"
      },
      {
        "from": "b-raw",
        "to": "b-adjust",
        "label": "未取得restore lock"
      },
      {
        "from": "b-adjust",
        "to": "b-effective",
        "label": "8000 − 3000"
      },
      {
        "from": "queued",
        "to": "retired",
        "label": "同序请求共同移出后；非计时保证"
      }
    ],
    "presentation": {
      "kind": "restore-budget-ledger",
      "panels": [
        {
          "title": "A：真实分配已记账",
          "tone": "kv",
          "nodeIds": [
            "a-raw",
            "a-adjust",
            "a-effective"
          ]
        },
        {
          "title": "B：失败预留继续记账",
          "tone": "control",
          "nodeIds": [
            "b-raw",
            "b-adjust",
            "b-effective"
          ]
        },
        {
          "title": "独立生命周期条件",
          "tone": "control",
          "nodeIds": [
            "queued",
            "retired"
          ]
        },
        {
          "title": "独立验收边界",
          "tone": "neutral",
          "nodeIds": [
            "budget-boundary"
          ]
        }
      ]
    }
  },
