        "tone": "kv",
        "column": 0,
        "row": 0
      },
      {
        "id": "peer-closed",
        "label": "对端关闭",
        "shortLabel": "对端关闭",
        "detail": "需要同时记录错误返回与宿主进程存活。",
        "tone": "danger",
        "column": 1,
        "row": 0
      },
      {
        "id": "peer-stalled",
        "label": "对端停止读取",
