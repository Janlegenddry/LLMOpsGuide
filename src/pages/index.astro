---
import BaseLayout from "../layouts/BaseLayout.astro";
import { entries, learningPath, sections } from "../data";
import { withBase } from "../paths";
import RadarIndex from '../components/RadarIndex.astro';
import { radar, radarHref } from '../radar';

const featured = radar.find(record => record.kind === 'analysis');
---

<BaseLayout>
  <div class="home-shell">
    <header class="home-brief" aria-labelledby="intro-title">
      <div class="home-brief__intro">
        <p class="home-brief__edition">李观志 / AI INFRA NOTES</p>
        <h1 id="intro-title">从推理运维，<br />走向 AI Infra。</h1>
        <p>追踪 SGLang 与推理系统进展，把每天的公开资料解读接到知识体系。结论先行，证据可追溯，问题带回实践。</p>
        <div class="home-brief__links">
          <a class="text-link" href="#radar">阅读动态</a>
          <a class="text-link text-link--muted" href="#path">系统学习</a>
        </div>
      </div>
      <aside class="home-latest" aria-labelledby="latest-title">
        <div class="home-latest__head">
          <h2 id="latest-title">本期深读</h2>
          <span>从 SLO 到系统选择</span>
        </div>
        {featured && (
          <a href={withBase(radarHref(featured.id))}>
            <span>原文 {featured.publishedAt} · 核对 {featured.reviewedAt}</span>
            <strong>{featured.title}</strong>
            <p>排队 → Prefill → KV 传输 → Decode<br />先还原关键路径，再讨论优化收益。</p>
          </a>
        )}
      </aside>
    </header>

    <dl class="library-facts" aria-label="知识库概览">
      <div><dt>公开记录</dt><dd>{radar.length}</dd></div>
      <div><dt>知识笔记</dt><dd>{entries.length}</dd></div>
      <div><dt>维护方式</dt><dd>持续校正</dd></div>
    </dl>

    <RadarIndex />

    <section class="home-path" id="path" aria-labelledby="path-title">
      <div class="section-heading">
        <h2 id="path-title">按顺序开始</h2>
        <p>先建立完整地图，再进入具体系统与故障现场。</p>
      </div>
      <ol class="learning-path">
        {learningPath.map((step) => (
          <li>
            <a href={withBase(step.href)}>
              <span class="learning-path__index">{step.index}</span>
              <span class="learning-path__body"><strong>{step.title}</strong><span>{step.description}</span></span>
              <span class="learning-path__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="library-index" id="notes" aria-labelledby="notes-title">
      <header class="library-index__head">
        <h2 id="notes-title">按主题浏览</h2>
        <p>文章之间互相引用，不追求孤立的知识点。</p>
      </header>
      <div class="notes-index">
        {sections.map((section) => {
          const sectionEntries = entries.filter((entry) => entry.section === section.title);
          return (
            <section class="note-group" id={`section-${section.id}`} aria-labelledby={`section-${section.id}-title`}>
              <header>
                <h3 id={`section-${section.id}-title`}>{section.title}</h3>
                <p>{section.description}</p>
              </header>
              <ul>
                {sectionEntries.map((entry) => (
                  <li>
                    <a href={withBase(entry.href)}>
                      <span><strong>{entry.title}</strong><span>{entry.description}</span></span>
                      <span class="note-group__meta">{entry.status}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })}
      </div>
    </section>

    <section class="maintenance-note" aria-labelledby="principles-title">
      <div class="section-heading">
        <h2 id="principles-title">维护约束</h2>
        <p>一份公开知识库，也是一套约束自己的学习方法。</p>
      </div>
      <dl class="principles">
        <div><dt>证据优先</dt><dd>区分日志事实、代码事实与推断，不用结论代替证据。</dd></div>
        <div><dt>结构优先</dt><dd>先回答它在系统中的位置，再解释局部原理。</dd></div>
        <div><dt>持续校正</dt><dd>保留更新时间和状态，让过时知识有迹可循。</dd></div>
      </dl>
    </section>
  </div>
</BaseLayout>
