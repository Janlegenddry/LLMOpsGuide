---
import BaseLayout from "../layouts/BaseLayout.astro";
import { entries, learningPath, sections } from "../data";
import { withBase } from "../paths";
---

<BaseLayout>
  <div class="home-shell">
    <section class="home-intro" aria-labelledby="intro-title">
      <p class="eyebrow">LLMOpsGuide · 2026</p>
      <h1 id="intro-title">LLMOps，系统地学。</h1>
      <p>这里记录我对模型生命周期、推理服务、可观测性与生产运维的理解。内容按学习顺序组织，也保留真实故障现场里的判断过程。</p>
      <div class="home-intro__links">
        <a class="text-link" href="#path">从学习路径开始</a>
        <a class="text-link text-link--muted" href="https://github.com/Janlegenddry/LLMOpsGuide" target="_blank" rel="noopener">在 GitHub 交流</a>
      </div>
    </section>

    <section class="indexed-section" id="path" aria-labelledby="path-title">
      <div class="section-heading">
        <p class="section-number">01</p>
        <div>
          <h2 id="path-title">学习路径</h2>
          <p>先形成完整地图，再进入具体系统与故障现场。</p>
        </div>
      </div>
      <ol class="learning-path">
        {learningPath.map((step) => (
          <li>
            <a href={withBase(step.href)}>
              <span class="learning-path__index">{step.index}</span>
              <span class="learning-path__body"><strong>{step.title}</strong><span>{step.description}</span></span>
              <span class="learning-path__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="indexed-section" id="notes" aria-labelledby="notes-title">
      <div class="section-heading">
        <p class="section-number">02</p>
        <div>
          <h2 id="notes-title">知识索引</h2>
          <p>按主题查找，文章之间互相引用，不追求孤立的知识点。</p>
        </div>
      </div>
      <div class="notes-index">
        {sections.map((section) => {
          const sectionEntries = entries.filter((entry) => entry.section === section.title);
          return (
            <section class="note-group" aria-labelledby={`section-${section.id}`}>
              <header>
                <h3 id={`section-${section.id}`}>{section.title}</h3>
                <p>{section.description}</p>
              </header>
              <ul>
                {sectionEntries.map((entry) => (
                  <li>
                    <a href={withBase(entry.href)}>
                      <span><strong>{entry.title}</strong><span>{entry.description}</span></span>
                      <span class="note-group__meta">{entry.status}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })}
      </div>
    </section>

    <section class="indexed-section indexed-section--compact" aria-labelledby="principles-title">
      <div class="section-heading">
        <p class="section-number">03</p>
        <div>
          <h2 id="principles-title">记录原则</h2>
          <p>一份公开知识库，也是一套约束自己的学习方法。</p>
        </div>
      </div>
      <dl class="principles">
        <div><dt>证据优先</dt><dd>区分日志事实、代码事实与推断，不用结论代替证据。</dd></div>
        <div><dt>结构优先</dt><dd>先回答它在系统中的位置，再解释局部原理。</dd></div>
        <div><dt>持续校正</dt><dd>保留更新时间和状态，让过时知识有迹可循。</dd></div>
      </dl>
    </section>
  </div>
</BaseLayout>
