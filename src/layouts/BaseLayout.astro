---
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "../styles/global.css";
import "../styles/almanac.css";
import "../styles/radar.css";
import "../styles/reader.css";
import "../styles/report.css";
import "../styles/library.css";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import SearchDialog from "../components/SearchDialog.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../paths";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Guanzhi Library",
  description = "李观志的个人知识图书馆：收录文章、完整报告、白皮书与阅读资料，按知识领域与主题导航，保留来源与判断的依据。",
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-design="reader-v1">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={withBase('/favicon.ico')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="48x48" href={withBase('/favicon-48.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Guanzhi的图书馆 · AI Infra 动态" href={withBase('/radar/feed.xml')} />
    <meta property="og:site_name" content="Guanzhi Library" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <title>{title}</title>
    <script is:inline>
      // The new reader starts light; old/system dark settings do not carry over.
      let savedTheme = null;
      try { savedTheme = localStorage.getItem("llmops-reader-theme-v1"); } catch {}
      document.documentElement.dataset.theme = savedTheme === "dark" ? "dark" : "light";
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <div class="site-frame">
      <Header />
      <Sidebar />
      <div class="site-main">
        <main id="main-content">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <SearchDialog />
  </body>
</html>
