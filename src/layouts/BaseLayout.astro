---
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "../styles/global.css";
import "../styles/almanac.css";
import "../styles/radar.css";
import "../styles/reader.css";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import SearchDialog from "../components/SearchDialog.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../paths";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "观志 · AI Infra 知识站 | LLMOpsGuide",
  description = "李观志的 AI Infra 公开知识站：SGLang 动态、GPU 通信、KV Cache、PD 分离、投机解码与故障分析。结论先行，证据可追溯。",
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-design="reader-v1">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="观志 AI Infra 动态" href={withBase('/radar/feed.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <title>{title}</title>
    <script is:inline>
      // The new reader starts light; old/system dark settings do not carry over.
      let savedTheme = null;
      try { savedTheme = localStorage.getItem("llmops-reader-theme-v1"); } catch {}
      document.documentElement.dataset.theme = savedTheme === "dark" ? "dark" : "light";
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <div class="site-frame">
      <Header />
      <Sidebar />
      <div class="site-main">
        <main id="main-content">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <SearchDialog />
  </body>
</html>
