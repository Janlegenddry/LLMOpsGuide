---
import BaseLayout from "./BaseLayout.astro";
import ArticleToc from "../components/ArticleToc.astro";
import { withBase } from "../paths";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    section: string;
    updated: string | Date;
    status?: string;
  };
}

const { frontmatter } = Astro.props;
const updatedValue = frontmatter.updated instanceof Date ? frontmatter.updated.toISOString() : String(frontmatter.updated);
const updated = updatedValue.slice(0, 10).replaceAll("-", ".");
---

<BaseLayout title={`${frontmatter.title} · LLMOpsGuide`} description={frontmatter.description}>
  <div class="article-shell">
    <article class="article" data-pagefind-body>
      <nav class="breadcrumb" aria-label="面包屑">
        <a href={withBase("/")}>首页</a>
        <span aria-hidden="true">/</span>
        <span>{frontmatter.section}</span>
      </nav>
      <header class="article-header">
        <p class="article-context">{frontmatter.section}</p>
        <h1>{frontmatter.title}</h1>
        <p class="article-deck">{frontmatter.description}</p>
        <dl class="article-meta">
          <div><dt>更新</dt><dd>{updated}</dd></div>
          <div><dt>状态</dt><dd>{frontmatter.status || "持续更新"}</dd></div>
        </dl>
      </header>
      <div class="prose">
        <slot />
      </div>
      <footer class="article-end">
        <p>这篇笔记会随着实践继续校正。发现问题，欢迎在 GitHub 交流。</p>
        <a href="https://github.com/Janlegenddry/LLMOpsGuide/issues" target="_blank" rel="noopener">提交反馈</a>
      </footer>
    </article>
    <ArticleToc />
  </div>
</BaseLayout>
