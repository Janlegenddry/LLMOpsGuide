---
import { withBase } from "../paths";
---

<header class="mobile-header">
  <a class="wordmark wordmark--mobile" href={withBase("/")} aria-label="LLMOpsGuide 首页">
    <span class="wordmark__mark" aria-hidden="true">L</span>
    <span>LLMOpsGuide</span>
  </a>
  <div class="mobile-header__actions">
    <button class="icon-button" type="button" data-search-open aria-label="搜索笔记" aria-haspopup="dialog" aria-controls="search-dialog">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
    </button>
    <button class="icon-button" id="nav-open" type="button" aria-label="打开知识库目录" aria-controls="site-sidebar" aria-expanded="false">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>
</header>
