---
import { entries } from "../data";
import { withBase } from "../paths";

const searchEntries = entries.map((entry) => ({ ...entry, href: withBase(entry.href) }));
---

<dialog class="search-dialog" id="search-dialog" aria-labelledby="search-title">
  <div class="search-dialog__panel">
    <div class="search-dialog__field">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <div class="search-dialog__control">
        <label for="search-input" id="search-title">搜索全部笔记</label>
        <input id="search-input" type="search" autocomplete="off" placeholder="例如：KV Cache" />
      </div>
      <button class="search-dialog__close" id="search-close" type="button" aria-label="关闭搜索">Esc</button>
    </div>
    <p class="search-dialog__meta" id="search-count" aria-live="polite">输入关键词，或选择最近更新</p>
    <div class="search-dialog__results" id="search-results" role="listbox" aria-label="搜索结果"></div>
    <p class="search-dialog__empty" id="search-empty" hidden>没有找到相关笔记。可以换一个关键词，或从学习路线开始。</p>
    <div class="search-dialog__footer" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>Enter</kbd> 打开</span>
      <span><kbd>Esc</kbd> 关闭</span>
    </div>
  </div>
</dialog>

<script is:inline type="application/json" id="search-data" set:html={JSON.stringify(searchEntries)}></script>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#search-dialog");
  const openButtons = document.querySelectorAll<HTMLButtonElement>("[data-search-open]");
  const closeButton = document.querySelector<HTMLButtonElement>("#search-close");
  const input = document.querySelector<HTMLInputElement>("#search-input");
  const results = document.querySelector<HTMLDivElement>("#search-results");
  const count = document.querySelector<HTMLParagraphElement>("#search-count");
  const empty = document.querySelector<HTMLParagraphElement>("#search-empty");
  const dataNode = document.querySelector<HTMLScriptElement>("#search-data");
  const searchData = dataNode ? JSON.parse(dataNode.textContent || "[]") : [];
  let activeIndex = 0;
  let filtered = searchData;
  let lastOpenButton: HTMLButtonElement | null = null;

  const normalize = (value: string) => value.toLocaleLowerCase().replace(/\s+/g, "");

  function render(query = "") {
    if (!results || !count || !empty) return;
    const needle = normalize(query);
    filtered = needle
      ? searchData.filter((entry: { title: string; description: string; section: string }) =>
          normalize(`${entry.title}${entry.description}${entry.section}`).includes(needle),
        )
      : searchData;
    activeIndex = 0;
    results.innerHTML = "";
    empty.hidden = filtered.length > 0;
    count.textContent = query ? `找到 ${filtered.length} 篇笔记` : "最近更新";

    filtered.forEach((entry: { title: string; description: string; href: string; section: string }, index: number) => {
      const link = document.createElement("a");
      link.className = `search-result${index === activeIndex ? " is-active" : ""}`;
      link.href = entry.href;
      link.setAttribute("role", "option");
      link.setAttribute("aria-selected", String(index === activeIndex));
      link.innerHTML = `<span class="search-result__section"></span><strong></strong><span class="search-result__description"></span>`;
      const section = link.querySelector(".search-result__section");
      const title = link.querySelector("strong");
      const description = link.querySelector(".search-result__description");
      if (section) section.textContent = entry.section;
      if (title) title.textContent = entry.title;
      if (description) description.textContent = entry.description;
      results.append(link);
    });
  }

  function updateActive(next: number) {
    const items = [...document.querySelectorAll<HTMLAnchorElement>(".search-result")];
    if (!items.length) return;
    activeIndex = (next + items.length) % items.length;
    items.forEach((item, index) => {
      const selected = index === activeIndex;
      item.classList.toggle("is-active", selected);
      item.setAttribute("aria-selected", String(selected));
    });
    items[activeIndex]?.scrollIntoView({ block: "nearest" });
  }

  function openSearch(opener?: HTMLButtonElement | null) {
    if (!dialog || !input) return;
    lastOpenButton = opener || null;
    render(input.value);
    dialog.showModal();
    document.querySelector(".site-frame")?.setAttribute("inert", "");
    window.setTimeout(() => input.focus(), 0);
  }

  function closeSearch() {
    if (!dialog) return;
    dialog.close();
    document.querySelector(".site-frame")?.removeAttribute("inert");
    lastOpenButton?.focus({ preventScroll: true });
  }

  openButtons.forEach((button) => button.addEventListener("click", () => openSearch(button)));
  closeButton?.addEventListener("click", closeSearch);
  input?.addEventListener("input", () => render(input.value));
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) closeSearch();
  });
  dialog?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeSearch();
  });
  dialog?.addEventListener("close", () => {
    document.querySelector(".site-frame")?.removeAttribute("inert");
    lastOpenButton?.focus({ preventScroll: true });
  });

  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      dialog?.open ? closeSearch() : openSearch(openButtons[0] || null);
      return;
    }
    if (!dialog?.open) return;
    if (event.key === "Escape") {
      event.preventDefault();
      closeSearch();
    } else if (event.key === "ArrowDown") {
      event.preventDefault();
      updateActive(activeIndex + 1);
    } else if (event.key === "ArrowUp") {
      event.preventDefault();
      updateActive(activeIndex - 1);
    } else if (event.key === "Enter" && document.activeElement === input) {
      event.preventDefault();
      const target = document.querySelectorAll<HTMLAnchorElement>(".search-result")[activeIndex];
      target?.click();
    }
  });
</script>
