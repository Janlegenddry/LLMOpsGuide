---
import ReportProvenance from './ReportProvenance.astro';
import { renderNumericalFigure } from '../lib/report-figures.mjs';
import type { ReportBars, RadarRecord } from '../radar';
interface Props { chart: ReportBars; sources: RadarRecord['sources']; figureID: string }
const { chart, sources, figureID } = Astro.props;
const desktop = renderNumericalFigure(chart, { id: `${figureID}-desktop` });
const mobile = renderNumericalFigure(chart, { compact: true, id: `${figureID}-mobile` });
---
<figure class="report-diagram" id={figureID} data-report-figure="bars">
  <figcaption><strong>{chart.title}</strong><ReportProvenance {...chart} sources={sources} /><p>{chart.caption}</p></figcaption>
  {chart.layout === 'rank-timeline' && <ul class="report-figure-key" aria-label="时间线图例"><li class="figure-key--compute">计算</li><li class="figure-key--waiting">等待同步</li><li class="figure-key--communication">通信</li></ul>}
  <div class="report-figure-desktop">{desktop.map(panel => <div class="report-figure-panel" set:html={panel.svg} />)}</div>
  <div class="report-figure-mobile">{mobile.map(panel => <div class="report-figure-panel" set:html={panel.svg} />)}</div>
  <details class="report-figure-notes"><summary>展开数值与计算口径</summary>
    <ul class="report-bars-values">{chart.series.map(s => <li><strong>{s.label}</strong>：{s.segments.map(segment => `${segment.label} ${segment.value} ${chart.unit}`).join(' + ')} = {s.segments.reduce((sum, v) => sum + v.value, 0)} {chart.unit}{s.rankTimes && <p>各 rank 计算时间：{s.rankTimes.join('、')} {chart.unit}。同步等待 = 最慢 rank − 当前 rank。</p>}{s.deliveredTokens && <p>实际提交 {s.deliveredTokens} token；单位成本 = {s.segments[0].value} ÷ {s.deliveredTokens} = {Number((s.segments[0].value / s.deliveredTokens).toPrecision(4))} {chart.unit}/token。</p>}</li>)}</ul>
  </details>
</figure>
